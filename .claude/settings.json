{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" claude session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" claude user-prompt-submit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" claude pre-read",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" claude pre-write",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/block-git-commit.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" claude pre-bash",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" claude post-read",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" claude post-write",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" claude post-bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" claude post-batch",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" claude precompact",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" claude stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" claude session-end",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/visibility-statusline.js\""
  }
}
