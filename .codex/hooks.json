{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" codex session-start",
            "timeout": 15,
            "statusMessage": "OpenWolf session bootstrap"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/block-git-commit.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" codex pre-bash",
            "timeout": 5,
            "statusMessage": "OpenWolf shell precheck"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" codex pre-read",
            "timeout": 5,
            "statusMessage": "OpenWolf read precheck"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" codex pre-write",
            "timeout": 60,
            "statusMessage": "OpenWolf write precheck"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" codex post-bash",
            "timeout": 10,
            "statusMessage": "OpenWolf shell tracking"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" codex post-read",
            "timeout": 5,
            "statusMessage": "OpenWolf read tracking"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" codex post-write",
            "timeout": 60,
            "statusMessage": "OpenWolf anatomy update"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" codex precompact",
            "timeout": 5,
            "statusMessage": "OpenWolf compaction snapshot"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" codex session-end",
            "timeout": 3,
            "statusMessage": "OpenWolf final flush"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" codex user-prompt-submit",
            "timeout": 5,
            "statusMessage": "OpenWolf context refresh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/medicina-naturista/.claude/hooks/openwolf-compat.js\" codex stop",
            "timeout": 10,
            "statusMessage": "OpenWolf session wrap-up"
          }
        ]
      }
    ]
  }
}
